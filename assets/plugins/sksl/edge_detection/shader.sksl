uniform shader content;
uniform float threshold;

float3 straight_rgb(half4 sample) {
    return sample.a > 0.0
        ? float3(sample.rgb) / float(sample.a)
        : float3(0.0);
}

half4 main(float2 p) {
    // Sobel kernels
    // Sample surrounding pixels
    float3 t00 = straight_rgb(content.eval(p + float2(-1, -1)));
    float3 t01 = straight_rgb(content.eval(p + float2( 0, -1)));
    float3 t02 = straight_rgb(content.eval(p + float2( 1, -1)));

    float3 t10 = straight_rgb(content.eval(p + float2(-1,  0)));
    float3 t12 = straight_rgb(content.eval(p + float2( 1,  0)));

    float3 t20 = straight_rgb(content.eval(p + float2(-1,  1)));
    float3 t21 = straight_rgb(content.eval(p + float2( 0,  1)));
    float3 t22 = straight_rgb(content.eval(p + float2( 1,  1)));

    // Horizontal Gradients
    float3 gx = t02 + 2.0*t12 + t22 - (t00 + 2.0*t10 + t20);

    // Vertical Gradients
    float3 gy = t20 + 2.0*t21 + t22 - (t00 + 2.0*t01 + t02);

    // Luma for edge detection
    float luma_x = dot(gx, float3(0.299, 0.587, 0.114));
    float luma_y = dot(gy, float3(0.299, 0.587, 0.114));

    float mag = sqrt(luma_x*luma_x + luma_y*luma_y);

    // Preserve layer coverage rather than manufacturing an opaque canvas.
    half alpha = content.eval(p).a;
    half edge = mag > threshold ? alpha : 0.0;
    return half4(edge, edge, edge, alpha);
}
