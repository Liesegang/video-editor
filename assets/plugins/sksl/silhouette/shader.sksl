uniform shader content;
uniform half4 color;


half4 main(float2 p) {
    half4 src = content.eval(p);
    // The uniform is straight-alpha Project-working color. Runtime shaders
    // return premultiplied pixels, so source coverage and authored opacity are
    // applied exactly once here.
    half coverage = src.a * color.a;
    return half4(color.rgb * coverage, coverage);
}
