uniform shader content;
uniform float intensity;
uniform half4 color;

half4 main(float2 p) {
    half4 source = content.eval(p);
    if (source.a <= 0.0) {
        return half4(0.0);
    }

    // The authored color is straight Project-working RGBA. Flash changes the
    // visible straight RGB while retaining the source object's coverage.
    float3 straight = float3(source.rgb) / float(source.a);
    straight += float3(color.rgb) * intensity * float(color.a);
    return half4(half3(straight * float(source.a)), source.a);
}
