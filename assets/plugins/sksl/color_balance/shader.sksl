uniform shader content;
uniform half3 shadows;
uniform half3 midtones;
uniform half3 highlights;

half4 main(float2 p) {
    half4 source = content.eval(p);
    if (source.a <= 0.0) {
        return half4(0.0);
    }
    float3 color = float3(source.rgb) / float(source.a);

    // Luma for weighting
    float luma = dot(color, float3(0.2126, 0.7152, 0.0722));

    // Weights
    float shadow_k = 1.0 - smoothstep(0.0, 0.5, luma);
    float highlight_k = smoothstep(0.5, 1.0, luma);
    float midtone_k = 1.0 - shadow_k - highlight_k;

    // Apply shifts
    color += float3(shadows) * shadow_k;
    color += float3(midtones) * midtone_k;
    color += float3(highlights) * highlight_k;

    // Clamp result
    color = clamp(color, 0.0, 1.0);

    return half4(half3(color * float(source.a)), source.a);
}
