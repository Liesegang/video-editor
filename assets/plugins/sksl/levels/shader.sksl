uniform shader content;
uniform float inBlack;
uniform float inWhite;
uniform float gamma;
uniform float outBlack;
uniform float outWhite;

half4 main(float2 p) {
    half4 source = content.eval(p);
    if (source.a <= 0.0) {
        return half4(0.0);
    }
    float3 color = float3(source.rgb) / float(source.a);

    // Avoid division by zero
    float iw = inWhite;
    if (abs(iw - inBlack) < 0.001) iw = inBlack + 0.001;

    // Input Mapping
    color = max(float3(0.0), color - inBlack);
    color = color / (iw - inBlack);
    color = clamp(color, 0.0, 1.0);

    // Gamma
    color = pow(color, float3(1.0 / max(0.001, gamma)));

    // Output Mapping
    color = color * (outWhite - outBlack) + outBlack;

    return half4(half3(color * float(source.a)), source.a);
}
