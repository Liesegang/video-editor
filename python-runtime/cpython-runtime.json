{
  "schema": 1,
  "implementation": "cpython",
  "version": "3.13.14",
  "gil": "standard",
  "distribution": "uv-managed",
  "package_layout": {
    "manifest": "python-runtime-manifest.json",
    "home": "python",
    "windows": {
      "loader_library": "python313.dll",
      "stdlib": "python/Lib",
      "extension_modules": "python/DLLs",
      "site_packages": "python/Lib/site-packages"
    },
    "unix": {
      "stdlib": "python/lib/python3.13",
      "site_packages": "python/lib/python3.13/site-packages"
    }
  }
}
